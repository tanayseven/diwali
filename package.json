{
	"name": "diwali",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"preview": "vite preview",
		"zip": "npm run build && mkdir -p dist && zip -r dist/game.zip www -x \"**/.DS_Store\"",
		"check": "tsc",
		"i18n": "typesafe-i18n",
		"bench": "vite build && node scripts/bench/run.mjs",
		"android:sync": "vite build && cap sync android",
		"android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
		"android:run": "npm run android:sync && cap run android"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.6.10",
		"playwright-core": "1.56.1",
		"source-map-js": "1.2.1",
		"typescript": "^5.6.3",
		"vite": "^5.4.10"
	},
	"dependencies": {
		"@capacitor/android": "^7.6.10",
		"@capacitor/core": "^7.6.10",
		"@capacitor/filesystem": "^7.1.9",
		"@capacitor/share": "^7.0.4",
		"@fontsource/baloo-bhai-2": "5.3.0",
		"@fontsource/baloo-bhaina-2": "5.3.0",
		"@fontsource/baloo-chettan-2": "5.3.0",
		"@fontsource/baloo-da-2": "5.3.0",
		"@fontsource/baloo-paaji-2": "5.3.0",
		"@fontsource/baloo-tamma-2": "5.3.0",
		"@fontsource/baloo-tammudu-2": "5.3.0",
